# Copy to .env and adjust. Loaded by your shell or a tool like direnv — the app
# itself reads plain environment variables (see internal/config).

# development => human-readable logs; anything else => JSON logs
APP_ENV=development

# --- HTTP server (Phase 2+) ---
HTTP_ADDR=:8080
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=30s
HTTP_SHUTDOWN_TIMEOUT=15s

# --- Concurrency engine (Phase 1) ---
ENGINE_WORKERS=50
ENGINE_TIMEOUT=5s
ENGINE_BUFFER=1000

# --- Postgres (Phase 3+) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/healthchecks?sslmode=disable
DB_MAX_CONNS=10
DB_MAX_CONN_IDLE=5m

# --- OAuth2 resource server (Phase 4+) ---
AUTH_ISSUER=
AUTH_AUDIENCE=
AUTH_JWKS_URL=
